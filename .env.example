# OPTIONAL REAL-LLM MODE: loaded only with CLI --provider deepseek.
# The default CLI and assignment demos are offline MOCK / DETERMINISTIC MODE.
# Store the real key only in .env.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT=180
LLM_MAX_OUTPUT_TOKENS=32768
DEEPSEEK_API_KEY=
# No .env is needed for offline demos; no automatic provider fallback is used.
