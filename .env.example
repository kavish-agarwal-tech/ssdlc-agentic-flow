# Default development path: local Ollama, no API key or paid service required.
LLM_PROVIDER=ollama
# Set this to a model tag installed with `ollama pull <tag>`.
LLM_MODEL=
LLM_BASE_URL=http://localhost:11434
LLM_TIMEOUT=180
LLM_CONTEXT_TOKENS=8192
LLM_MAX_OUTPUT_TOKENS=4096
LLM_THINK=false
LLM_CONCURRENCY=1
# Optional per-role overrides, e.g. {"coding":"installed-coding-model"}
LLM_ROLE_MODELS={}
# DeepSeek alternative: uncomment, then replace the API key locally.
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-flash
# LLM_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY=replace-with-your-key
# Optional explicit fallback; never falls back from a real model to mocks.
# LLM_FALLBACK_PROVIDER=ollama
# LLM_FALLBACK_MODEL=another-installed-model
# LLM_FALLBACK_BASE_URL=http://localhost:11434
# Hosted/local custom integration:
# LLM_PROVIDER=plugin
# LLM_FACTORY=my_provider:create
# Keep any provider credentials in environment variables, never source files.
